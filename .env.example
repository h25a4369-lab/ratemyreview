# Copy this file to .env and change the values before sharing the site.
# All values are optional — the defaults are fine for local development.

# Signs the session cookie. Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# Where the SQLite file lives (default: rate_my_review.db in the project root).
# DATABASE_PATH=rate_my_review.db

# Set to true only when the site is served over HTTPS.
SESSION_HTTPS_ONLY=false
